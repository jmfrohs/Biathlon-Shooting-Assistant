{
  "name": "biathlon-shooting-assistant-server",
  "version": "1.0.0",
  "description": "Backend server for Biathlon Shooting Assistant",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "stop": "taskkill /F /IM node.exe 2>nul || echo No server running",
    "restart": "npm run stop && npm start",
    "backup:create": "node scripts/backup-manager.js create",
    "backup:list": "node scripts/backup-manager.js list",
    "backup:prune": "node scripts/backup-manager.js prune",
    "backup:restore": "node scripts/backup-manager.js restore",
    "backup:install-cron": "bash scripts/install-backup-cron.sh"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "socket.io": "^4.8.3"
  }
}
