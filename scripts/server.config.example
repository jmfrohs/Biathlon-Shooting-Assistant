# Biathlon-Shooting-Assistant Server Configuration — Template

# Copy/Paste into: scripts/server.config
# Then fill in the values

# DuckDNS Token (from duckdns.org -> top of the page)
DUCKDNS_TOKEN="YOUR-TOKEN-HERE"

# DuckDNS Domain (without .duckdns.org)
DUCKDNS_DOMAIN="biathlon-shooting-assistant"

# HTTPS Domain for Caddy (optional).
# If empty, DUCKDNS_DOMAIN + .duckdns.org will be used automatically.
# If no DuckDNS data is provided either, HTTPS will be set up with a self-signed
# certificate on SERVER_IP (or automatically detected IP).
HTTPS_DOMAIN=""

# Internal port of the Node app (Default: 3001)
APP_PORT="3001"

# Linux Server IP (leave empty = will be detected automatically)
SERVER_IP=""
